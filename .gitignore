# {morph,idiom,idiom_arc}_data/: yalnız label_space.json commit'lenir (küçük, modele gömülür,
# reprodüksiyon için); gerisi (JSON split'ler, .pt, HF export yedekleri, indirilen/fetch'lenen
# treebank'ler) izlenmez. Not: vendored UD treebank data/treebanks/ altında, izlenir.
morph_data/*
!morph_data/label_space.json
dizgebert_morph_hf/
dizgebert_joint_hf/
# idiom_data/: aynı mantık — yalnız label_space.json commit'lenir, PARSEME .cupt/JSON'lar
# CC-BY-NC-SA 4.0 lisanslı (fetch_parseme_tr.py ile yeniden üretilir), izlenmez.
idiom_data/*
!idiom_data/label_space.json
idiom_arc_data/*
!idiom_arc_data/label_space.json
dizgebert_idiom_hf/

